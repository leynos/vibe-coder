{
  "name": "vibe-coder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tokens:build": "bun tokens/build/style-dictionary.js",
    "fmt": "bunx biome format --write src tests tools scripts package.json biome.jsonc bunfig.toml",
    "lint": "bunx biome ci src tests tools",
    "check:types": "tsc --noEmit --skipLibCheck",
    "test": "bun test --preload ./tests/setup-happy-dom.ts --preload ./tests/setup-snapshot-guard.ts",
    "test:a11y": "vitest --run --config vitest.a11y.config.ts",
    "test:a11y:watch": "vitest --watch --config vitest.a11y.config.ts",
    "test:e2e": "bash scripts/e2e.sh",
    "test:e2e:container": "bash scripts/e2e-container.sh",
    "lint:ftl-vars": "bun run scripts/check-fluent-vars.ts",
    "semantic:lint": "bunx biome ci src tests tools && bun run lint:imports && bun run lint:classlist && bun run lint:class-duplicates && bun run lint:hardcoded-strings && uvx semgrep --config tools/semgrep-semantic.yml --include src/**/*.tsx --include tests/**/*.tsx && bunx stylelint 'src/**/*.css' --config tools/stylelint.config.cjs",
    "semantic": "bun run semantic:lint",
    "lint:classlist": "bun run scripts/check-classlist-length.ts",
    "lint:class-duplicates": "bun run scripts/find-near-duplicate-classes.ts",
    "lint:hardcoded-strings": "bun run scripts/check-hardcoded-strings.ts",
    "lint:imports": "bun run scripts/lint-import-boundaries.ts",
    "test:all": "bun lint && bun check:types && bun test && bun run test:a11y && bun run lint:ftl-vars && bun run semantic && bun test:e2e",
    "ff": "bunx --bun @tailwindcss/cli --input src/index.css --output tmp/tailwind.css --verbose && rm -f tmp/tailwind.css && bun run test:all"
  },
  "dependencies": {
    "@fluent/bundle": "^0.19.1",
    "@radix-ui/react-accordion": "^1.2.15",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-slider": "^1.4.2",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-toggle-group": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-router": "^1.170.17",
    "clsx": "^2.1.1",
    "daisyui": "^5.6.13",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-fluent": "^2.0.0",
    "i18next-fluent-backend": "^1.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "tailwindcss": "^4.3.2",
    "valibot": "^1.4.2",
    "xstate": "^5.32.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.2",
    "@fluent/syntax": "^0.19.0",
    "@getgrit/cli": "^0.1.0-alpha.1743007075",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "axe-core": "^4.12.1",
    "bun-types": "^1.3.14",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.6",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.16",
    "style-dictionary": "^5.5.0",
    "stylelint": "^17.14.0",
    "stylelint-declaration-strict-value": "^1.10.11",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
